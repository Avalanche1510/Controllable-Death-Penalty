{
	"schemaVersion": 1,
	"id": "controllable-death-penalty",
	"version": "${version}",
	"name": "Controllable Death Penalty",
	"description": "No more FULL loss of Items, or ALWAYS keep items, or graves! This minecraft mod provides customizable, trade-off settings to preserve your important assets, and AT THE SAME TIME, still reserve acceptable death penalty.",
	"authors": [
		"Avalanche1510"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Avalanche1510/Controllable-Death-Penalty"
	},
	"license": "CC0-1.0",
	"icon": "assets/controllable-death-penalty/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cdp.ControllableDeathPenalty"
		],
		"client": [
			"com.cdp.client.ControllableDeathPenaltyClient"
		],
		"fabric-datagen": [
			"com.cdp.client.ControllableDeathPenaltyDataGenerator"
		]
	},
	"mixins": [
		"controllable-death-penalty.mixins.json",
		{
			"config": "controllable-death-penalty.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}